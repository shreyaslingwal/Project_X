# Project X Environment Configuration

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding Settings (Local CPU FastEmbed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# FlashRank Reranker Settings (Local CPU)
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# Retrieval Parameters
TOP_K_RETRIEVAL=15
TOP_K_RERANK=4

# Ingestion & Chunking Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Storage Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/faiss_index

# Optional API Keys (for optional cloud fallbacks)
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
